<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="right"
    android:orientation="vertical"
    tools:context=".ui.profile.ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/customize_button"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="4dp"
            android:text="@string/customize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        style="@android:style/Widget.DeviceDefault.Light.ScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbarStyle="insideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/profile_picture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/avatar_filler"
                    tools:srcCompat="@drawable/avatar_filler" />

                <TextView
                    android:id="@+id/profile_username"
                    android:layout_width="326dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/nav_header_title"
                    android:textAlignment="center"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/profile_user_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/nav_header_subtitle"
                    android:textAlignment="center"
                    android:textSize="20sp" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/streak_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="🔥 0 Week Streak"
                    android:textAlignment="center"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8sp"
                    android:layout_marginTop="16sp"
                    android:layout_marginRight="8sp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/best_workout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/best_workout"
                        android:textAlignment="center"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/best_workout_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_workouts"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8sp"
                    android:layout_marginTop="16sp"
                    android:layout_marginRight="8sp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/favorite_workout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favorite_workout"
                        android:textAlignment="center"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/favorite_workout_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_workouts"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8sp"
                    android:layout_marginTop="16sp"
                    android:layout_marginRight="8sp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/favorite_muscle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favorite_muscle"
                        android:textAlignment="center"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/favorite_muscle_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_workouts"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="48dp"
                android:orientation="vertical">

                <com.jjoe64.graphview.GraphView
                    android:id="@+id/workoutDaysGraph"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="24dp" />

                <com.jjoe64.graphview.GraphView
                    android:id="@+id/workoutMonthGraph"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="54dp" />

                <Button
                    android:id="@+id/moreGraphsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:text="@string/graphs_button" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
