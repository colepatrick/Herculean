<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackgroundFloating"
    tools:context=".workout.Upload">

    <LinearLayout
        android:id="@+id/uploadLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Workout Type Spinner -->
        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/spinnerValue"
            android:gravity="center"
            android:padding="8dp"
            android:backgroundTint="?attr/colorPrimary"
            android:popupBackground="?attr/colorSurface" />

        <!-- List of Previous Workouts -->
        <ListView
            android:id="@+id/workoutList"
            android:layout_width="match_parent"
            android:layout_height="214dp"
            android:layout_marginTop="16dp"
            android:divider="?attr/colorOnBackground"
            android:dividerHeight="0.5dp" />

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Upload Workout"
            android:textColor="?attr/colorOnBackground"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Weight Input -->
        <EditText
            android:id="@+id/editTextWeight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:hint="Weight (lbs)"
            android:inputType="numberDecimal"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- Sets Input -->
        <EditText
            android:id="@+id/editTextSets"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="Sets"
            android:inputType="number"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- Reps Input -->
        <EditText
            android:id="@+id/editTextReps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="Reps"
            android:inputType="number"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- Upload Button -->
        <Button
            android:id="@+id/buttonUploadWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            android:text="Upload Workout" />

        <!-- Home Button -->
        <Button
            android:id="@+id/homeButton"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnSecondary"
            android:text="Home" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
