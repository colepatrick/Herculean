<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <ImageView
        android:id="@+id/friendAvatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:src="@drawable/avatar_filler"
        android:scaleType="centerCrop"
        android:background="@drawable/profile_pic_border"
        android:layout_alignParentStart="true" />

    <LinearLayout
        android:layout_toRightOf="@id/friendAvatar"
        android:layout_toLeftOf="@id/followBtn"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/friendUsername"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/friendEmail"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/friendFavorite"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <Button
        android:id="@+id/followBtn"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/button_round_primary"
        android:text="Follow"
        android:textColor="@android:color/white"
        android:padding="6dp" />

</RelativeLayout>
